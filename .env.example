# New Relic User API key (starts with NRAK-). See README for how to create one.
NEW_RELIC_API_KEY=
# Entity GUID of the APM application to watch. See README for where to find it.
NEW_RELIC_ENTITY_GUID=
# Optional: US or EU. Leave empty to auto-detect.
NEW_RELIC_REGION=

# BUSY Bar address on your LAN (IP, hostname or full URL)
BUSY_BAR_ADDR=
# Optional: device HTTP API password, sent as X-API-Token
BUSY_BAR_TOKEN=

# Timing (seconds) and draw priority (1-100)
POLL_SECONDS=60
FLIP_SECONDS=10
PRIORITY=50
